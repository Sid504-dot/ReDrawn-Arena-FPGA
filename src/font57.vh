function [4:0] font57;
	input [7:0] ch;
	input [2:0] row;
	reg [34:0] g;
	begin
		case (ch)
			8'h20: g = 35'b00000000000000000000000000000000000; // ' '
			8'h30: g = 35'b01110100011001110101110011000101110; // '0'
			8'h31: g = 35'b00100011000010000100001000010001110; // '1'
			8'h32: g = 35'b01110100010000100010001000100011111; // '2'
			8'h33: g = 35'b11111000100010000010000011000101110; // '3'
			8'h34: g = 35'b00010001100101010010111110001000010; // '4'
			8'h35: g = 35'b11111100001111000001000011000101110; // '5'
			8'h36: g = 35'b00110010001000011110100011000101110; // '6'
			8'h37: g = 35'b11111000010001000100010000100001000; // '7'
			8'h38: g = 35'b01110100011000101110100011000101110; // '8'
			8'h39: g = 35'b01110100011000101111000010001001100; // '9'
			8'h41: g = 35'b01110100011000111111100011000110001; // 'A'
			8'h42: g = 35'b11110100011000111110100011000111110; // 'B'
			8'h43: g = 35'b01110100011000010000100001000101110; // 'C'
			8'h44: g = 35'b11110100011000110001100011000111110; // 'D'
			8'h45: g = 35'b11111100001000011110100001000011111; // 'E'
			8'h46: g = 35'b11111100001000011110100001000010000; // 'F'
			8'h47: g = 35'b01110100011000010111100011000101111; // 'G'
			8'h48: g = 35'b10001100011000111111100011000110001; // 'H'
			8'h49: g = 35'b01110001000010000100001000010001110; // 'I'
			8'h4A: g = 35'b00111000100001000010000101001001100; // 'J'
			8'h4B: g = 35'b10001100101010011000101001001010001; // 'K'
			8'h4C: g = 35'b10000100001000010000100001000011111; // 'L'
			8'h4D: g = 35'b10001110111010110101100011000110001; // 'M'
			8'h4E: g = 35'b10001100011100110101100111000110001; // 'N'
			8'h4F: g = 35'b01110100011000110001100011000101110; // 'O'
			8'h50: g = 35'b11110100011000111110100001000010000; // 'P'
			8'h51: g = 35'b01110100011000110001101011001001101; // 'Q'
			8'h52: g = 35'b11110100011000111110101001001010001; // 'R'
			8'h53: g = 35'b01111100001000001110000010000111110; // 'S'
			8'h54: g = 35'b11111001000010000100001000010000100; // 'T'
			8'h55: g = 35'b10001100011000110001100011000101110; // 'U'
			8'h56: g = 35'b10001100011000110001100010101000100; // 'V'
			8'h57: g = 35'b10001100011000110101101011010101010; // 'W'
			8'h58: g = 35'b10001100010101000100010101000110001; // 'X'
			8'h59: g = 35'b10001100010101000100001000010000100; // 'Y'
			8'h5A: g = 35'b11111000010001000100010001000011111; // 'Z'
			8'h3A: g = 35'b00000001000010000000001000010000000; // ':'
			8'h2D: g = 35'b00000000000000011111000000000000000; // '-'
			8'h2F: g = 35'b00001000010001000100010001000010000; // '/'
			8'h3D: g = 35'b00000000001111100000111110000000000; // '='
			8'h2E: g = 35'b00000000000000000000000000110001100; // '.'
			8'h3E: g = 35'b01000001000001000001000100010001000; // '>'
			8'h21: g = 35'b00100001000010000100001000000000100; // '!'
			8'h3F: g = 35'b01110100010000100010001000000000100; // '?'
			default: g = 35'd0;
		endcase
		font57 = (row < 7) ? g[34 - row*5 -: 5] : 5'd0;
	end
endfunction
