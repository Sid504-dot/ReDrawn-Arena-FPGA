function [11:0] palette;
    input [3:0] idx;
    case (idx)
        4'h0: palette = 12'h000; // '.'
        4'h1: palette = 12'h223; // 'k'
        4'h2: palette = 12'hFFF; // 'w'
        4'h3: palette = 12'h697; // 'g'
        4'h4: palette = 12'h9B8; // 'l'
        4'h5: palette = 12'h976; // 'b'
        4'h6: palette = 12'hCA8; // 't'
        4'h7: palette = 12'hC77; // 'r'
        4'h8: palette = 12'hEA7; // 'o'
        4'h9: palette = 12'hE64; // 'f'
        4'hA: palette = 12'h59D; // 'u'
        4'hB: palette = 12'hADE; // 'c'
        4'hC: palette = 12'h889; // 'e'
        4'hD: palette = 12'hE9A; // 'p'
        4'hE: palette = 12'hB56; // 'd'
        4'hF: palette = 12'hFD5; // 'y'
        default: palette = 12'h000;
    endcase
endfunction
