
function [2:0] font35;
	input [7:0] ch;
	input [2:0] row;
	reg [14:0] g;
	begin
		case (ch)
			8'h30: g = 15'b111101101101111; // '0'
			8'h31: g = 15'b010110010010111; // '1'
			8'h32: g = 15'b110001010100111; // '2'
			8'h33: g = 15'b110001010001110; // '3'
			8'h34: g = 15'b101101111001001; // '4'
			8'h35: g = 15'b111100110001110; // '5'
			8'h36: g = 15'b011100111101111; // '6'
			8'h37: g = 15'b111001010010010; // '7'
			8'h38: g = 15'b111101111101111; // '8'
			8'h39: g = 15'b111101111001110; // '9'
			8'h41: g = 15'b010101111101101; // 'A'
			8'h42: g = 15'b110101110101110; // 'B'
			8'h43: g = 15'b011100100100011; // 'C'
			8'h44: g = 15'b110101101101110; // 'D'
			8'h45: g = 15'b111100110100111; // 'E'
			8'h46: g = 15'b111100110100100; // 'F'
			8'h47: g = 15'b011100101101011; // 'G'
			8'h48: g = 15'b101101111101101; // 'H'
			8'h49: g = 15'b111010010010111; // 'I'
			8'h4A: g = 15'b001001001101010; // 'J'
			8'h4B: g = 15'b101101110101101; // 'K'
			8'h4C: g = 15'b100100100100111; // 'L'
			8'h4D: g = 15'b101111101101101; // 'M'
			8'h4E: g = 15'b110101101101101; // 'N'
			8'h4F: g = 15'b010101101101010; // 'O'
			8'h50: g = 15'b110101110100100; // 'P'
			8'h51: g = 15'b010101101110011; // 'Q'
			8'h52: g = 15'b110101110101101; // 'R'
			8'h53: g = 15'b011100010001110; // 'S'
			8'h54: g = 15'b111010010010010; // 'T'
			8'h55: g = 15'b101101101101111; // 'U'
			8'h56: g = 15'b101101101101010; // 'V'
			8'h57: g = 15'b101101101111101; // 'W'
			8'h58: g = 15'b101101010101101; // 'X'
			8'h59: g = 15'b101101010010010; // 'Y'
			8'h5A: g = 15'b111001010100111; // 'Z'
			8'h3A: g = 15'b000010000010000; // ':'
			8'h3E: g = 15'b100010001010100; // '>'
			8'h3C: g = 15'b001010100010001; // '<'
			8'h2F: g = 15'b001001010100100; // '/'
			8'h3D: g = 15'b000111000111000; // '='
			8'h2E: g = 15'b000000000000010; // '.'
			8'h2D: g = 15'b000000111000000; // '-'
			8'h21: g = 15'b010010010000010; // '!'
			default: g = 15'b0;
		endcase
		case (row)
			3'd0: font35 = g[14:12];
			3'd1: font35 = g[11:9];
			3'd2: font35 = g[8:6];
			3'd3: font35 = g[5:3];
			3'd4: font35 = g[2:0];
			default: font35 = 3'b0;
		endcase
	end
endfunction
